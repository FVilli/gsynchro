{
  "name": "gsynchro",
  "version": "0.1.3",
  "description": "Bidirectional sync of selected project files with a locally mounted folder",
  "license": "MIT",
  "type": "module",
  "bin": {
    "gsynchro": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "schema.png"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "gsynchro": "tsx src/cli.ts"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "fast-glob": "^3.3.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
